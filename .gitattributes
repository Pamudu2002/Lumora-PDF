# Normalize line endings: LF in the repo and working tree (CRLF only where Windows needs it).
* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.ico binary
*.icns binary
*.woff2 binary
*.ttf binary

# Test corpus and golden images live in Git LFS
tests/corpus/**/*.pdf filter=lfs diff=lfs merge=lfs -text
tests/golden/**/*.png filter=lfs diff=lfs merge=lfs -text
